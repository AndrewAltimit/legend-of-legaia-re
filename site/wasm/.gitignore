# Ignore wasm-pack noise but track the artifacts the site loads.
*
!.gitignore
!legaia_web_viewer.js
!legaia_web_viewer.d.ts
!legaia_web_viewer_bg.wasm
!legaia_web_viewer_bg.wasm.d.ts
!package.json
# Written by scripts/ci/build-wasm.sh, verified by check-wasm-freshness.py.
# Must be tracked: an ignored stamp makes the freshness gate answer "unknown"
# in every fresh clone.
!SOURCE_STAMP.json
